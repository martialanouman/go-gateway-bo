{
  "name": "gateway-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tableau de bord Admin / Exploitation de la passerelle SMS — TanStack Start (BFF + React)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "mock": "prism mock node_modules/@martialanouman/gateway-api-contracts/openapi-admin.yaml --port 4010 --errors",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --project db",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "vuln": "pnpm audit --audit-level=low",
    "check": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm vuln && pnpm build",
    "db:seed": "tsx src/server/auth/cli.ts seed",
    "auth:bootstrap": "tsx src/server/auth/cli.ts bootstrap"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@martialanouman/gateway-api-contracts": "1.0.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "drizzle-orm": "0.45.2",
    "openapi-fetch": "0.17.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@stoplight/prism-cli": "5.16.0",
    "@stoplight/prism-core": "5.16.0",
    "@stoplight/prism-http": "5.16.0",
    "@stoplight/prism-http-server": "5.16.0",
    "@tanstack/nitro-v2-vite-plugin": "1.155.0",
    "@testcontainers/postgresql": "12.0.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "h3": "1.15.11",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
