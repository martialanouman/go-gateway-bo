# Copier en `.env` pour le développement local. Aucune valeur réelle ne doit
# atterrir ici : `.env.example` est commité, `.env` ne l'est jamais (§1.8 du plan).
#
# La configuration est validée au démarrage : une variable obligatoire absente
# **empêche le lancement** et est nommée. Un serveur qui démarre puis échoue à la
# première requête laisse croire que l'installation est bonne.
#
# Ce fichier est tenu par un test : il liste exactement les variables que lit
# `internal/config`, ni plus ni moins. Chaque step ajoute les siennes en même
# temps que le code qui les lit — documenter un réglage sans effet est un
# mensonge d'interface.

# --- Serveur (step-000) ------------------------------------------------------

# Adresse d'écoute du BFF. Obligatoire, sans valeur par défaut : une adresse qu'on croit
# bonne est pire qu'un refus de démarrer.
DASHBOARD_ADDR=:3001

# Délai de grâce laissé aux requêtes en vol lors d'un arrêt. Facultatif, 15s par
# défaut. C'est lui qui rend un déploiement roulant transparent (step-186).
DASHBOARD_SHUTDOWN_TIMEOUT=15s

# --- Passerelle (step-003) ---------------------------------------------------

# À qui le BFF parle : `real` (l'API Admin) ou `mock` (Prism, `make mock`).
# Facultatif, `real` par défaut : une production qui oublie la variable exige
# tout le matériel d'authentification, et une production volontairement en
# `mock` se lit dans son environnement. Le développement local tient en `mock`.
DASHBOARD_GATEWAY_MODE=mock

# Adresse de l'API Admin. Obligatoire dans les deux modes, sans valeur par
# défaut. Le préfixe de chemin en fait partie : la vraie API sert sous `/v1`
# (`https://admin.gateway.internal/v1`), le mock Prism sans préfixe.
# En mode `real`, le schéma `https` est exigé et `http` refusé au démarrage :
# en clair, le mTLS de la connexion sortante ne serait jamais présenté et le
# jeton machine partirait sur le fil à chaque appel. Le mock reste en `http`.
DASHBOARD_GATEWAY_BASE_URL=http://127.0.0.1:4010

# Identifiants OAuth2 client_credentials du jeton machine. Obligatoires en mode
# `real` seulement, sans valeur par défaut. Le secret n'a jamais d'exemple : il
# se renseigne dans `.env`, que rien ne commite.
DASHBOARD_GATEWAY_TOKEN_URL=
DASHBOARD_GATEWAY_CLIENT_ID=
DASHBOARD_GATEWAY_CLIENT_SECRET=

# Matériel mTLS de la connexion sortante, en chemins de fichiers : certificat
# client, sa clé privée, et l'autorité qui signe la passerelle. Obligatoires en
# mode `real` seulement. Ce sont des chemins, jamais le contenu des fichiers.
DASHBOARD_GATEWAY_CLIENT_CERT=
DASHBOARD_GATEWAY_CLIENT_KEY=
DASHBOARD_GATEWAY_CA_CERT=

# Délai maximal d'un appel sortant vers l'API Admin, obtention du jeton
# comprise. Facultatif, 10s par défaut.
DASHBOARD_GATEWAY_TIMEOUT=10s

# --- Base de données (step-005) ----------------------------------------------

# DSN du schéma propre au BFF — opérateurs, rôles, audit, alertes. Jamais celui
# de la passerelle (§1.3). Obligatoire, sans valeur par défaut, et validé au
# démarrage : mal formé, le binaire refuse de démarrer en nommant la variable,
# sans jamais citer la valeur, qui porte le mot de passe de la base.
# La forme `clé=valeur` de libpq (`host=… user=…`) est acceptée aussi.
# La base doit répondre **au démarrage** et porter les migrations : depuis
# step-020, le binaire compare la version du schéma appliquée à celle qu'il
# embarque, avant même de lier son port, et refuse de servir sur un schéma en
# retard en nommant les deux versions. Une base injoignable l'arrête aussi.
# Sur un poste neuf : `docker compose up -d`, puis `make migrate`, puis `make bootstrap`.
# La valeur ci-dessous est celle du `docker-compose.yml` de développement, dont
# les identifiants sont publics et locaux — une production met les siens dans
# `.env`, que rien ne commite.
DASHBOARD_DATABASE_URL=postgres://dashboard:dashboard@127.0.0.1:5432/dashboard?sslmode=disable

# --- Authentification (step-021) ---------------------------------------------

# Sel du HMAC qui masque les adresses sources dans la table des compteurs
# d'échecs. Obligatoire, 32 caractères au minimum, **sans aucun repli** : une
# valeur codée en dur serait publique, donc le HMAC serait devinable et la table
# redeviendrait un registre lisible de qui a tapé à la porte.
# `openssl rand -base64 48` fait le travail.
# Le changer n'invalide aucun compte, et ne déverrouille rien non plus :
# seules les clés des compteurs **par adresse source** en dépendent. Ceux par
# adresse électronique gardent la leur et continuent de courir.
DASHBOARD_BRUTEFORCE_SALT=

# Réseaux CIDR dont l'en-tête `X-Forwarded-For` est cru, séparés par des
# virgules. Facultatif, vide par défaut — et vide est **sûr** : l'en-tête est
# alors ignoré et le compteur porte sur l'adresse de pair, ce qui est exact en
# développement où rien ne s'interpose.
# En production, derrière le load balancer, ne pas la renseigner ferait compter
# toutes les tentatives sur l'adresse du load balancer : le verrouillage se
# refermerait sur tout le monde d'un coup. Une adresse nue est refusée — écrire
# le préfixe, `10.0.0.1/32` et non `10.0.0.1`.
DASHBOARD_TRUSTED_PROXIES=

# --- Premier opérateur (step-021) --------------------------------------------

# Le compte propriétaire que `make bootstrap` crée. **Obligatoires à la première
# installation seulement** : la commande se rejoue à chaque déploiement, et elle
# ne les lit que lorsque la base ne porte aucun opérateur. Contrairement aux
# variables du serveur, leur absence n'empêche donc aucun lancement — elle
# n'empêche que la création du premier compte, sur une base qui n'en a pas.
# Lues dans l'environnement et non en argument, qu'un `ps aux` afficherait.
# Le mot de passe fait 12 caractères au minimum. C'est le mot de passe permanent
# du compte propriétaire — rien ne le fait tourner aujourd'hui, et le changer se
# fera depuis l'écran de gestion des opérateurs (step-029), où se créent aussi
# les comptes suivants, sous une permission et avec un audit.
DASHBOARD_BOOTSTRAP_OPERATOR_EMAIL=
DASHBOARD_BOOTSTRAP_OPERATOR_NAME=
DASHBOARD_BOOTSTRAP_OPERATOR_PASSWORD=
