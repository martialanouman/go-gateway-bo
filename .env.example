# Copier en `.env` pour le développement local. Aucune valeur réelle ne doit atterrir ici :
# `.env.example` est commité, `.env` ne l'est jamais (§1.8 du plan d'exécution).
#
# La configuration est validée au démarrage : une variable requise absente doit faire échouer le
# lancement bruyamment, jamais retomber sur une valeur par défaut silencieuse.

# --- Serveur ---------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- API Admin de la passerelle (step-001) ---------------------------------------------------
# Le BFF est le seul à connaître ces valeurs : elles ne franchissent jamais la frontière
# serveur / client (§1.3, invariant d).

# 'mock' : les écrans se développent contre Prism (`pnpm mock`) — 71 des 134 opérations du contrat
#          n'existent pas encore côté passerelle, c'est donc le mode normal de développement.
# 'live' : le BFF parle à la vraie passerelle. OAuth2 client_credentials et mTLS deviennent requis.
#
# Un seul réglage, sans valeur par défaut, plutôt qu'un booléen doublé d'une seconde URL : personne
# n'a jamais à se demander laquelle des deux adresses gagne, et un `GATEWAY_MODE=False` mal
# orthographié échoue au démarrage au lieu d'être lu comme « vraie passerelle ».
GATEWAY_MODE=mock

# En mode 'mock', l'adresse que sert `pnpm mock`. En mode 'live', celle de la passerelle.
GATEWAY_ADMIN_BASE_URL=http://127.0.0.1:4010

# Délai au-delà duquel une requête est abandonnée. Optionnel — 10 000 ms par défaut. Le tableau de
# bord n'est jamais sur le chemin critique du plan de données (invariant e) : mieux vaut un écran
# qui annonce que la passerelle ne répond pas qu'un écran qui attend en tenant une connexion.
# GATEWAY_TIMEOUT_MS=10000

# Mode 'live' uniquement. Le jeton obtenu ici est un jeton MACHINE à scopes fixes : il porte
# `content:read` en permanence et ne représente pas l'opérateur connecté. La restriction par
# opérateur est entièrement à la charge du BFF (invariant c).
GATEWAY_OAUTH_TOKEN_URL=https://admin.gateway.internal/oauth/token
GATEWAY_OAUTH_CLIENT_ID=
GATEWAY_OAUTH_CLIENT_SECRET=

# Chemins des certificats mTLS du client — jamais leur contenu : une variable d'environnement
# ressort dans un `docker inspect` ou une page de diagnostic.
GATEWAY_MTLS_CERT_PATH=
GATEWAY_MTLS_KEY_PATH=
GATEWAY_MTLS_CA_PATH=

# --- Magasins propres au BFF (step-002) ------------------------------------------------------
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
REDIS_URL=redis://localhost:6379

# --- Session & secrets (step-022, step-181) --------------------------------------------------
SESSION_SECRET=
ALERTMANAGER_WEBHOOK_SECRET=
