{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    // Le compilateur ne produit rien : Vite transpile. `tsc --noEmit` n'est qu'une porte de qualité.
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // §1.1 du plan d'exécution : ces trois-là ne se négocient pas.
    // `noUncheckedIndexedAccess` force à traiter `arr[i]` comme potentiellement absent — c'est ce qui
    // attrape les accès de tableau optimistes sur des réponses d'API paginées.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Déclaré explicitement : TypeScript 7 n'inclut pas `node_modules/@types/*`
    // automatiquement comme le faisait TS 5 — vérifié, `--listFilesOnly` n'en
    // remontait aucun fichier. Les tests de la charte lisent les tokens sur
    // disque, d'où le besoin.
    "types": ["node", "vite/client"],

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // Les tests posés à la racine de `web/` en font partie : sans eux, une erreur de type dans le
  // fichier qui porte le critère d'acceptation de la step ne serait attrapée par aucune porte —
  // vérifié. `vitest.artefact.config.ts` a disparu avec la v1.0.
  "include": ["src", "e2e", "test", "*.config.ts", "*.test.ts"]
}
