{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    // Le compilateur ne produit rien : Vite transpile. `tsc --noEmit` n'est qu'une porte de qualité.
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // §1.1 du plan d'exécution : ces trois-là ne se négocient pas.
    // `noUncheckedIndexedAccess` force à traiter `arr[i]` comme potentiellement absent — c'est ce qui
    // attrape les accès de tableau optimistes sur des réponses d'API paginées.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
